# RatelPlus Inventory API - Production Environment
# Copy this to .env on production server and update values!

# Database
DATABASE_URL="postgresql://postgres:StrongPassword@postgres:5432/ratelplus_inventory?schema=public"

# JWT Secret - MUST be unique and strong! Generate a new one!
# Generate a secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-very-long-random-secret-key-for-production"

# Server Config
PORT=3000
NODE_ENV=production
CORS_ORIGINS="https://inventory.ratelplus.net.ng"

# SMTP Configuration (optional)
# If not set, email service will be disabled gracefully
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
