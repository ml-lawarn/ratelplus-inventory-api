# RatelPlus Inventory API - Production Environment
# Copy this to .env on production server and update values!

# Database
DATABASE_URL="postgresql://postgres:StrongPassword@postgres:5432/ratelplus_inventory?schema=public"

# JWT Secret - MUST be unique, strong, and at least 32 characters! Generate a new one!
# Generate a secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-very-long-random-secret-key-for-production"

# Access token lifetime. Kept short since there is currently no refresh-token
# flow and no way to revoke a single leaked token before it expires.
JWT_EXPIRES_IN=1d

# Server Config
PORT=3000
NODE_ENV=production
CORS_ORIGINS="https://inventory.ratelplus.net.ng"

# Set to "true" to expose /api/docs (Swagger) in production. Leave unset to
# keep it disabled outside development.
ENABLE_SWAGGER=false

# Initial SUPER_ADMIN account, created only once by `prisma db seed` (skipped
# if a user with this email already exists). If SEED_ADMIN_PASSWORD is left
# unset, a strong random password is generated and printed ONCE to the
# console output of the seed run — capture it immediately, it cannot be
# recovered afterwards.
SEED_ADMIN_EMAIL="admin@ratelplus.net"
SEED_ADMIN_PASSWORD=

# SMTP Configuration (optional)
# If not set, email service will be disabled gracefully
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
