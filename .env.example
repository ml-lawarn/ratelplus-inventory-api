DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME"
JWT_SECRET="super-secret"
PORT=3000
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# Set to "true" to expose /api/docs (Swagger) outside development.
ENABLE_SWAGGER=true

# Initial SUPER_ADMIN account created by `prisma db seed`. Leave
# SEED_ADMIN_PASSWORD unset to have a random one generated and printed once.
SEED_ADMIN_EMAIL="admin@ratelplus.net"
SEED_ADMIN_PASSWORD=

# SMTP Configuration (optional - if not set, email service will be disabled)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com